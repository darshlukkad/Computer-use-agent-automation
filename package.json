{
  "name": "cua-automation",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.6"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "discover": "node --import tsx src/cli.ts discover",
    "replay": "node --import tsx src/cli.ts replay",
    "approve": "node --import tsx src/cli.ts approve",
    "probe": "node --import tsx src/cli.ts probe",
    "session": "node --import tsx src/cli.ts session",
    "takeover": "node --import tsx src/cli.ts takeover",
    "handback": "node --import tsx src/cli.ts handback",
    "resume": "node --import tsx src/cli.ts resume",
    "proxy": "node --import tsx proxy/server.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.117.1",
    "openai": "^7.5.0",
    "playwright": "^1.62.1",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3"
  }
}
