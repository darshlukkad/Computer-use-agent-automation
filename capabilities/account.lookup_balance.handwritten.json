{
  "_note": "TEMPORARY schema-gate fixture, hand-written to prove the schema can express the real ParaBank flow before a replay engine is built on it. DELETE once the LLM-discovered artifact lands (build step 4). Not a deliverable: provenance.liveLlm is false.",
  "apiVersion": "cua.capability/v1",
  "kind": "Capability",
  "metadata": {
    "id": "account.lookup_balance",
    "version": "1.0.0",
    "status": "draft",
    "title": "Look up an account's current balance",
    "description": "Signs in to the servicing console, opens the accounts overview, and returns the current balance for the given account number."
  },
  "provenance": {
    "discoveryRunId": "handwritten-schema-gate",
    "model": "none",
    "createdAt": "2026-08-16T00:00:00.000Z",
    "runnerVersion": "0.1.0",
    "liveLlm": false
  },
  "compatibility": {
    "vendor": "parasoft",
    "product": "parabank",
    "versionRange": ">=5.0.0 <6.0.0"
  },
  "entry": {
    "originAllowlist": ["http://localhost:8080", "http://127.0.0.1:8080"],
    "path": "/parabank/index.htm"
  },
  "signature": {
    "inputs": {
      "accountId": {
        "type": "string",
        "required": true,
        "pii": "identifier",
        "pattern": "^[0-9]{5}$",
        "description": "The account number to look up, as shown in the accounts overview."
      }
    },
    "outputs": {
      "balance": {
        "type": "money",
        "pii": "none",
        "description": "Current balance of the account."
      }
    }
  },
  "preconditions": [{ "kind": "text_present", "text": "Customer Login" }],
  "steps": [
    {
      "id": "s1_open",
      "action": "navigate",
      "effect": "observation",
      "risk": "safe",
      "postcondition": { "kind": "text_present", "text": "Customer Login" }
    },
    {
      "id": "s2_username",
      "action": "fill",
      "value": { "kind": "secret", "ref": "PARABANK_USERNAME" },
      "target": {
        "strategies": [
          { "kind": "role_name", "role": "textbox", "name": "Username" },
          { "kind": "label", "text": "Username" },
          { "kind": "nearby_text", "text": "Username", "direction": "below" }
        ],
        "rationale": "The input carries no id, no <label> and no aria-label, so rungs 1 and 2 resolve to zero elements on this app. The bold caption 'Username' immediately above the field is the only stable anchor, and it is what a human operator uses. Rungs 1-2 are retained because a future version may add proper labelling."
      },
      "effect": "idempotent_write",
      "risk": "safe",
      "postcondition": {
        "kind": "value_non_empty",
        "target": {
          "strategies": [{ "kind": "nearby_text", "text": "Username", "direction": "below" }],
          "rationale": "Same control as the fill; asserts it took a value without recording the credential."
        }
      }
    },
    {
      "id": "s3_password",
      "action": "fill",
      "value": { "kind": "secret", "ref": "PARABANK_PASSWORD" },
      "target": {
        "strategies": [
          { "kind": "role_name", "role": "textbox", "name": "Password" },
          { "kind": "label", "text": "Password" },
          { "kind": "nearby_text", "text": "Password", "direction": "below" }
        ],
        "rationale": "Same structure as the username field — the caption is a sibling <b>, not a label."
      },
      "effect": "idempotent_write",
      "risk": "safe",
      "postcondition": {
        "kind": "value_non_empty",
        "target": {
          "strategies": [{ "kind": "nearby_text", "text": "Password", "direction": "below" }],
          "rationale": "Proves the field was filled without writing the secret into the artifact."
        }
      }
    },
    {
      "id": "s4_signin",
      "action": "click",
      "target": {
        "strategies": [
          { "kind": "role_name", "role": "button", "name": "Log In" },
          { "kind": "css", "selector": "input[value='Log In']" }
        ],
        "rationale": "The submit control is an <input type=submit>, whose accessible name derives from its value attribute, so rung 1 is expected to hold here even though the text fields have no names. CSS is retained as a last resort and firing it is recorded as drift."
      },
      "effect": "idempotent_write",
      "risk": "safe",
      "timeoutMs": 20000,
      "postcondition": { "kind": "text_present", "text": "Accounts Overview" }
    },
    {
      "id": "s5_await_rows",
      "action": "wait",
      "effect": "observation",
      "risk": "safe",
      "timeoutMs": 20000,
      "precondition": { "kind": "text_present", "text": "Accounts Overview" },
      "postcondition": {
        "kind": "count_at_least",
        "n": 1,
        "target": {
          "strategies": [{ "kind": "css", "selector": "#accountTable tbody tr" }],
          "rationale": "The accounts table body is populated by script; the served HTML ships an empty <tbody>. We wait on rows existing rather than on a duration. No semantic locator can express 'rows of this table', so this is a legitimate rung-5 use rather than a degraded fallback."
        }
      }
    },
    {
      "id": "s6_read_balance",
      "action": "read",
      "extractTo": "balance",
      "target": {
        "strategies": [
          { "kind": "table_cell", "header": "Balance*", "rowMatch": "${inputs.accountId}" }
        ],
        "rationale": "The column is located by its visible header text and the row by the account number, so neither column order nor row order matters. This is how an operator reads the same value."
      },
      "effect": "observation",
      "risk": "safe",
      "maxAttempts": 3
    }
  ],
  "exceptions": [
    {
      "id": "e_account_not_found",
      "when": {
        "kind": "all",
        "items": [
          { "kind": "text_present", "text": "Accounts Overview" },
          { "kind": "text_absent", "text": "${inputs.accountId}" }
        ]
      },
      "class": "business_outcome",
      "code": "ACCOUNT_NOT_FOUND",
      "verified": false
    },
    {
      "id": "e_session_expired",
      "when": {
        "kind": "all",
        "items": [
          { "kind": "text_present", "text": "internal error" },
          { "kind": "text_absent", "text": "Accounts Overview" }
        ]
      },
      "class": "recoverable",
      "code": "SESSION_EXPIRED",
      "recover": { "strategy": "re_login" },
      "verified": false
    }
  ],
  "success": {
    "checkpoint": {
      "kind": "all",
      "items": [
        { "kind": "text_present", "text": "Accounts Overview" },
        { "kind": "text_present", "text": "${inputs.accountId}" }
      ]
    },
    "extract": [{ "output": "balance", "from": "s6_read_balance" }]
  }
}
