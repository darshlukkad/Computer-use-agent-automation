{
  "apiVersion": "cua.capability/v1",
  "kind": "Capability",
  "metadata": {
    "id": "account.lookup_balance",
    "version": "1.0.0",
    "status": "approved",
    "title": "look up account {{account_number}} and read its current balance",
    "description": "Discovered from a live run against localhost:8080.",
    "digest": "25b845878994a1e7e23078a9451818776d8225347139d6596e67ced7f627c8ff",
    "approval": {
      "digest": "25b845878994a1e7e23078a9451818776d8225347139d6596e67ced7f627c8ff",
      "approverId": "darsh@personal.com",
      "approvedAt": "2026-08-19T02:51:23.962Z"
    }
  },
  "provenance": {
    "discoveryRunId": "evidence/discover-2026-08-18T21-52-08-515Z",
    "model": "openai:gpt-5.2",
    "createdAt": "2026-08-18T21:52:28.394Z",
    "runnerVersion": "0.1.0",
    "liveLlm": true
  },
  "compatibility": {
    "vendor": "parasoft",
    "product": "parabank",
    "versionRange": ">=5.0.0 <6.0.0"
  },
  "entry": {
    "originAllowlist": [
      "http://localhost:8080"
    ],
    "path": "/parabank/index.htm"
  },
  "signature": {
    "inputs": {
      "account_number": {
        "type": "string",
        "required": true,
        "pii": "identifier",
        "description": "Supplied per invocation; identified a control during discovery."
      }
    },
    "outputs": {
      "current_balance": {
        "type": "money",
        "required": true,
        "pii": "none",
        "description": "Read from the cell under \"Balance*\" during discovery."
      }
    }
  },
  "preconditions": [
    {
      "kind": "text_present",
      "text": "Customer Login"
    }
  ],
  "steps": [
    {
      "id": "s1_open",
      "action": "navigate",
      "effect": "observation",
      "risk": "safe",
      "postcondition": {
        "kind": "text_present",
        "text": "Customer Login"
      },
      "timeoutMs": 15000,
      "maxAttempts": 1,
      "onError": "fail"
    },
    {
      "id": "s2_fill_username",
      "action": "fill",
      "target": {
        "strategies": [
          {
            "kind": "label",
            "text": "Username"
          },
          {
            "kind": "nearby_text",
            "text": "Username",
            "direction": "below"
          }
        ],
        "baselineRung": 2,
        "rationale": "Recorded from a live run: its visible caption is \"Username\", which is what an operator reads because the application gives this control no name of its own."
      },
      "value": {
        "kind": "secret",
        "ref": "operator_username"
      },
      "effect": "idempotent_write",
      "risk": "safe",
      "postcondition": {
        "kind": "value_non_empty",
        "target": {
          "strategies": [
            {
              "kind": "label",
              "text": "Username"
            },
            {
              "kind": "nearby_text",
              "text": "Username",
              "direction": "below"
            }
          ],
          "baselineRung": 2,
          "rationale": "The control written by this step; asserts the write landed."
        }
      },
      "timeoutMs": 15000,
      "maxAttempts": 1,
      "onError": "fail"
    },
    {
      "id": "s3_fill_password",
      "action": "fill",
      "target": {
        "strategies": [
          {
            "kind": "label",
            "text": "Password"
          },
          {
            "kind": "nearby_text",
            "text": "Password",
            "direction": "below"
          }
        ],
        "baselineRung": 2,
        "rationale": "Recorded from a live run: its visible caption is \"Password\", which is what an operator reads because the application gives this control no name of its own."
      },
      "value": {
        "kind": "secret",
        "ref": "operator_password"
      },
      "effect": "idempotent_write",
      "risk": "safe",
      "postcondition": {
        "kind": "value_non_empty",
        "target": {
          "strategies": [
            {
              "kind": "label",
              "text": "Password"
            },
            {
              "kind": "nearby_text",
              "text": "Password",
              "direction": "below"
            }
          ],
          "baselineRung": 2,
          "rationale": "The control written by this step; asserts the write landed."
        }
      },
      "timeoutMs": 15000,
      "maxAttempts": 1,
      "onError": "fail"
    },
    {
      "id": "s4_click_log_in",
      "action": "click",
      "target": {
        "strategies": [
          {
            "kind": "role_name",
            "role": "button",
            "name": "Log In"
          }
        ],
        "baselineRung": 1,
        "rationale": "Recorded from a live run: the application names this control \"Log In\"."
      },
      "effect": "idempotent_write",
      "risk": "safe",
      "postcondition": {
        "kind": "text_present",
        "text": "Account Services"
      },
      "timeoutMs": 20000,
      "maxAttempts": 1,
      "onError": "fail"
    },
    {
      "id": "s5_read_balance",
      "action": "read",
      "target": {
        "strategies": [
          {
            "kind": "table_cell",
            "header": "Balance*",
            "rowMatch": "${inputs.account_number}"
          }
        ],
        "baselineRung": 1,
        "rationale": "Recorded from a live run: it is the cell under \"Balance*\" in the row for \"13122\", so neither column order nor row order matters."
      },
      "effect": "observation",
      "risk": "safe",
      "timeoutMs": 15000,
      "maxAttempts": 3,
      "extractTo": "current_balance",
      "onError": "fail"
    }
  ],
  "exceptions": [
    {
      "id": "x_account_not_found",
      "when": {
        "kind": "all",
        "items": [
          {
            "kind": "text_present",
            "text": "Account Services"
          },
          {
            "kind": "text_absent",
            "text": "${inputs.account_number}"
          }
        ]
      },
      "class": "business_outcome",
      "code": "ACCOUNT_NOT_FOUND",
      "answer": "No account ${inputs.account_number} is visible to this operator, so no balance could be read.",
      "verified": true
    }
  ],
  "success": {
    "checkpoint": {
      "kind": "all",
      "items": [
        {
          "kind": "text_present",
          "text": "Account Services"
        },
        {
          "kind": "text_present",
          "text": "${inputs.account_number}"
        }
      ]
    },
    "extract": [
      {
        "output": "current_balance",
        "from": "s5_read_balance"
      }
    ]
  }
}
