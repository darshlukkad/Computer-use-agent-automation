# Copy to .env and fill in. Never commit .env.
#
# Credentials are a runtime binding, never a capability input — an input would land
# in shell history, the result contract, logs and evidence. Artifacts name a LOGICAL
# ROLE (`operator_password`); the deployment decides which credential that is.

# --- the shared default, used when no tenant is given ---------------------------
# ParaBank's built-in demo account. Synthetic data; not real credentials.
OPERATOR_USERNAME=john
OPERATOR_PASSWORD=demo

# --- per-tenant override -------------------------------------------------------
# <TENANT>_<ROLE> wins over the shared default, so one approved artifact serves
# every tenant running the same vendor product without being edited.
# SUMMIT_OPERATOR_USERNAME=
# SUMMIT_OPERATOR_PASSWORD=

# --- model access, for the discovery run only ----------------------------------
# One key, either provider. The provider is inferred from the key prefix
# (`sk-ant-…` → Anthropic, anything else → OpenAI) and can be forced with
# LLM_PROVIDER below.
#
# Replay never reads this. An architecture test walks the import graph from the
# replay engine and fails if any model SDK is reachable from it.
LLM_API_KEY=

# Optional overrides. Left unset, each provider uses its own current default.
# LLM_PROVIDER=anthropic        # anthropic | openai — overrides prefix detection
# LLM_MODEL=
